# --- Secretos y datos de tu cuenta: nunca versionar ----------------------
*.tfvars.secret
.env
*.pem
credentials.tfrc.json

# terraform.tfvars identifica TU cuenta, TU usuario y TU repositorio. Se
# versiona `terraform.tfvars.example` con valores de relleno; el real, no.
terraform.tfvars
*.auto.tfvars
!terraform.tfvars.example

# --- Terraform ------------------------------------------------------------
.terraform/
.terraform.lock.hcl
terraform.tfstate
terraform.tfstate.*
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# --- SAM / AWS ------------------------------------------------------------
.aws-sam/
packaged.yaml
samconfig-*.toml

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/
.pytest_cache/

# --- Go -------------------------------------------------------------------
bootstrap
*.test

# --- Artefactos de build --------------------------------------------------
# Los genera `make bin`; se reconstruyen en cada maquina, no se versionan.
lambda-functions/build/
**/lambda-functions/build/
.build/
**/.build/
*.tar.gz
# Excepciones: artefactos que SI se versionan porque son entrada de tests o del
# ejemplo del motor, no salida de un build.
!hands-on/02-hcp-terraform/modules/engine/example-product/product.tar.gz
!hands-on/01-terraform-os/modules/engine/sample-provisioning-artifacts/*.tar.gz
# Fixtures de los tests Go. Sin ellos, `go test` pasa en local (donde el fichero
# esta en disco pero ignorado) y falla en un checkout limpio. Son ~44 KB en total.
!**/test-artifacts/*.tar.gz
dist/*.whl

# --- SO / editor ----------------------------------------------------------
.DS_Store
.idea/
.vscode/

# Planes guardados y binarios compilados sueltos
tfplan
*.tfplan

# Lo escribe el workflow de despliegue en tiempo de ejecucion. En local el state
# es un fichero, asi que este backend no debe acabar versionado.
backend.tf

# Lock transitorio de terraform
*.tfstate.lock.info
.terraform.tfstate.lock.info
